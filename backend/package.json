{
  "name": "techstore-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de TechStore — Node.js + Express + PostgreSQL (Sequelize)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "sequelize-cli db:migrate --config src/config/sequelize.config.cjs --migrations-path src/migrations",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config src/config/sequelize.config.cjs --migrations-path src/migrations",
    "db:seed:all": "sequelize-cli db:seed:all --config src/config/sequelize.config.cjs --seeders-path src/seeders",
    "db:seed:undo:all": "sequelize-cli db:seed:undo:all --config src/config/sequelize.config.cjs --seeders-path src/seeders",
    "test": "cross-env NODE_ENV=test DB_NAME=techstore_test NODE_OPTIONS=--experimental-vm-modules jest --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/src/**/*.test.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "openai": "^7.23.0",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.9.0",
    "jest": "^30.5.2",
    "prettier": "^3.3.3",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.0"
  }
}
